  "tokenColors": [
    {
      "settings": {
        "background": "#00120F",
        "foreground": "#B5F0CF"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5A8A75", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "text.literal"],
      "settings": { "foreground": "#9AC97F" }
    },
    {
      "scope": ["constant.character.escape", "string.escape"],
      "settings": { "foreground": "#7FC4A4" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#CBE487" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#27A9B3" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#C7E2D2" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#9AC97F" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#7FC4A4" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#27A9B3" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#7FC4A4" }
    },
    {
      "scope": ["variable", "variable.parameter"],
      "settings": { "foreground": "#B5F0CF" }
    },
    {
      "scope": ["variable.language", "variable.other.constant"],
      "settings": { "foreground": "#13B7BF" }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#8FB9A4" }
    },
    {
      "scope": ["punctuation.definition.tag"],
      "settings": { "foreground": "#8FB9A4" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#B6EE9C", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#B6EE9C", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#B6EE9C", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#58D2C0" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#B3745D" }
    },
    {
      "scope": ["support.constant.property-value", "constant.other.symbol"],
      "settings": { "foreground": "#13B7BF" }
    }
  ]
}
